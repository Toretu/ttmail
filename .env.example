# Copy to .env with bin/init-env.sh. Never commit .env.
APP_ENV=development
APP_URL=http://127.0.0.1:8081

DB_HOST=db
DB_PORT=3306
DB_NAME=mailings
DB_USER=mailings
DB_PASSWORD=__generated__
DB_ROOT_PASSWORD=__generated__

# Microsoft 365 (Graph) connection. See docs/office365-setup.md. Leave empty until the Entra app exists.
# The client secret must only ever live here (or the server's protected environment); never in the database or browser.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Sign-in. People sign in with Microsoft 365 (same Entra app as GRAPH_*; add APP_URL/auth/callback as a Web redirect URI).
# The first sign-in by this address creates the initial administrator when no admin exists yet.
AUTH_BOOTSTRAP_ADMIN=
# Development only: enables a "dev login" button. Ignored unless APP_ENV=development. Never set to 1 in production.
AUTH_DEV_LOGIN=1
